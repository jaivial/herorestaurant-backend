# Backend production env — TEMPLATE.
# Copy to backend/.env.prod (same directory) and fill REAL values.
# backend/.env.prod is untracked: NEVER commit real secrets.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=villacarmen
DB_PASSWORD=changeme
DB_NAME=newvillacarmen
DEFAULT_RESTAURANT_ID=1

# Set by compose (PORT=8080, STATIC_DIR=/app/static); listed for reference.
PORT=8080
STATIC_DIR=/app/static

# Public origins allowed to call the API.
CORS_ALLOW_ORIGINS=https://alqueriavillacarmen.com,https://www.alqueriavillacarmen.com,https://backoffice.alqueriavillacarmen.com

# Strong tokens. ADMIN_TOKEN gates legacy admin /api endpoints when non-empty.
# INTERNAL_API_TOKEN gates /api/n8nReminder.php (must match what n8n sends,
# if that automation is live; empty = denied).
ADMIN_TOKEN=changeme-strong-token
INTERNAL_API_TOKEN=changeme-n8n-token

# Bunny media storage (images served from the CDN pull zone).
BUNNY_PULL_BASE_URL=https://villacarmenmedia.b-cdn.net
BUNNY_PULL_BASE_URL_CLIENT=https://villacarmenmedia.b-cdn.net
BUNNY_STORAGE_ZONE=villacarmen
BUNNY_STORAGE_ACCESS_KEY=changeme
BUNNY_MEMBERS_PULL_BASE_URL=https://herorestaurantmedia.b-cdn.net
BUNNY_MEMBERS_STORAGE_ZONE=herorestaurant
BUNNY_MEMBERS_STORAGE_ACCESS_KEY=changeme

# WhatsApp bot (self-hosted Evolution API; instance credentials live in DB).
MINIMAX_API_KEY=changeme
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
ASSISTANT_MINIMAX_MODEL=MiniMax-M3

# Public webhook + absolute links pointing at the new prod subdomain.
BOT_PUBLIC_WEBHOOK_URL=https://backoffice.alqueriavillacarmen.com
BACKOFFICE_PUBLIC_BASE_URL=https://backoffice.alqueriavillacarmen.com
EVOLUTION_WEBHOOK_SECRET=changeme-same-value-as-current-dev

# Optional integrations — only set in prod if actually used:
# CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_EMAIL / CLOUDFLARE_API_KEY /
# CLOUDFLARE_API_TOKEN / INSTATIC_* / STRIPE_SECRET_KEY /
# STRIPE_WEBHOOK_SECRET / VAULT_TOKEN
