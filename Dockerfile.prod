# syntax=docker/dockerfile:1
# Production image for Villa Carmen: Go API + the compiled preact public site.
#
# Build context MUST be the multi-repo root (/var/www/newvillacarmen) so both
# the Go source (backend/) and the public frontend source
# (preactvillacarmen/frontend/) are visible. Context size is kept small by
# backend/Dockerfile.prod.dockerignore (BuildKit per-Dockerfile ignore file).
#
# Rebuilding this image IS the way to redeploy the public frontend:
# the dist is baked into the image and served by the Go binary from STATIC_DIR.

# ---------- Stage 1: build the public preact frontend ----------
FROM node:22-alpine AS frontend
WORKDIR /src
COPY preactvillacarmen/frontend/package.json preactvillacarmen/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY preactvillacarmen/frontend/ ./
# tsc -b && vite build -> /src/dist
RUN npm run build

# ---------- Stage 2: build the Go backend ----------
FROM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/cmd ./cmd
COPY backend/internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -mod=mod -trimpath -o /out/backend ./cmd/server

# ---------- Stage 3: runtime ----------
FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata imagemagick imagemagick-jpeg imagemagick-webp
WORKDIR /app
COPY --from=build /out/backend /app/backend
COPY --from=frontend /src/dist /app/static

ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/app/backend"]
