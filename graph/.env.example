# Neo4j credentials for the code graph. Copy to .env and set a real password.
NEO4J_PASSWORD=change-me
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j

# LLM for the DSPy layer: cliproxy gateway (OpenAI-compatible).
GRAPH_LM_BASE_URL=http://127.0.0.1:8317/v1
GRAPH_LM_MODEL=openai/opencode-go-acct1/hy3
GRAPH_LM_API_KEY=
